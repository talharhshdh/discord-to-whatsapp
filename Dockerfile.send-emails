FROM node:24-alpine AS builder

WORKDIR /app

ENV YOUTUBE_DL_SKIP_PYTHON_CHECK=1

# Copy packaging and compiler configurations
COPY package*.json tsconfig.json ./

# Install all dependencies (development + production)
RUN npm install

# Copy the TypeScript source files and CV assets
COPY src/ ./src/
COPY services/ ./services/

# Compile the TypeScript files
RUN npx tsc

# Production stage
FROM node:24-alpine

WORKDIR /app

ENV YOUTUBE_DL_SKIP_PYTHON_CHECK=1

# Copy packaging config
COPY package*.json ./

# Install only production dependencies
RUN npm install

# Copy the compiled JS files and CV assets from the builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/services ./services

# Define production environment
ENV NODE_ENV=production

# Execute the job application sender script
CMD ["node", "dist/scripts/send-local-emails.js"]
