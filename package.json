{
  "name": "discord-whatsapp-bridge",
  "version": "1.0.0",
  "description": "Bridge Discord messages to WhatsApp",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"const{mkdirSync,copyFileSync}=require('fs');mkdirSync('dist/libs',{recursive:true});\" ",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dashboard:install": "cd dashboard && npm install",
    "dashboard:build": "cd dashboard && npm run build"
  },
  "keywords": [
    "discord",
    "whatsapp",
    "bridge"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.5",
    "ab-downloader": "^1.0.2",
    "btch-downloader": "^6.0.27",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "pino": "^8.19.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "youtube-dl-exec": "^3.1.5",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
