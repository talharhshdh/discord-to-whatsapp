# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Server ID (Guild ID) to listen to
# Right-click on server icon -> Copy Server ID
DISCORD_SERVER_ID=your_server_id_here

# Authorized WhatsApp numbers (with country code, no + or spaces).
# The bot will:
#  - Execute commands (.sticker, media links) sent FROM any of these numbers.
#  - Forward Discord messages TO all of these numbers.
# Separate multiple numbers with commas (no spaces around commas).
# Example: 12025551234,923185853847,447911123456
WHATSAPP_RECIPIENT=your_number_here,optional_admin2_here

# ── Dashboard / Cloudflare Tunnel ─────────────────────────────────────────────
# The dashboard React app is built and served statically by the same Node server
# that handles all /api/* routes (dashboard-server.ts, port 4000).
# Both are exposed through a single Cloudflare tunnel — no base URL config needed.
#
# The bot automatically uses a random trycloudflare.com URL each session and
# sends the fresh URL to all WhatsApp admins on startup.
#
# Optional: use a named tunnel for a FIXED domain every session.
# 1. Cloudflare Zero Trust → Tunnels → Create tunnel → copy the token
# 2. Add public hostname: yourdomain.com → localhost:4000
# CLOUDFLARE_TUNNEL_TOKEN=
