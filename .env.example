# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Server ID (Guild ID) to listen to
# Right-click on server icon -> Copy Server ID
DISCORD_SERVER_ID=your_server_id_here

# Authorized WhatsApp numbers (with country code, no + or spaces).
# The bot will:
#  - Execute commands (.sticker, media links) sent FROM any of these numbers.
#  - Forward Discord messages TO all of these numbers.
# Separate multiple numbers with commas (no spaces around commas).
# Example: 12025551234,923185853847,447911123456
WHATSAPP_RECIPIENT=your_number_here,optional_admin2_here
